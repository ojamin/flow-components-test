{
  "name": "@flow-builder/components",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "component-source.manifest.json",
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles/component-runtime.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./catalog": "./dist/generated/catalog.js",
    "./source-manifest": "./dist/generated/source-manifest.js",
    "./source-files": "./dist/generated/source-files.js",
    "./manifest": "./dist/manifest.js",
    "./sdk": "./dist/sdk/public-sdk.js",
    "./sdk/browser": "./dist/sdk/helpers/browser/index.js",
    "./sdk/rendering": "./dist/sdk/helpers/rendering/index.js",
    "./sdk/capabilities": "./dist/sdk/helpers/capabilities/index.js",
    "./sdk/three-d": "./dist/sdk/helpers/three-d/index.js",
    "./sdk/interactions": "./dist/sdk/helpers/interactions/index.js",
    "./sdk/data": "./dist/sdk/helpers/data/index.js",
    "./sdk/config": "./dist/sdk/helpers/config/index.js",
    "./sdk/theme": "./dist/sdk/theme.js",
    "./sdk/sanitization": "./dist/sdk/helpers/sanitization/index.js",
    "./sdk/markdown": "./dist/sdk/helpers/markdown/index.js",
    "./component-ui": "./dist/sdk/component-ui.js",
    "./testing": "./dist/testing/index.js",
    "./runtime-services": "./dist/sdk/runtime-services/index.js",
    "./shared/view-container": "./dist/shared/view-container/index.js",
    "./shared/nav": "./dist/shared/nav/index.js",
    "./styles/component-runtime.css": "./dist/styles/component-runtime.css"
  },
  "scripts": {
    "generate": "node --loader ./scripts/package-alias-loader.mjs --experimental-strip-types scripts/generate-catalog.ts --write",
    "generate:check": "node --loader ./scripts/package-alias-loader.mjs --experimental-strip-types scripts/validate-library.ts",
    "prove:definition-loader": "node --loader ./scripts/package-alias-loader.mjs --experimental-strip-types scripts/prove-definition-loader.ts",
    "scaffold": "node --loader ./scripts/package-alias-loader.mjs --experimental-strip-types scripts/scaffold-component.ts",
    "validate": "node --loader ./scripts/package-alias-loader.mjs --experimental-strip-types scripts/validate-library.ts",
    "policy:lifecycle": "node tooling/standalone-policy.mjs lifecycle",
    "policy:exports": "node tooling/standalone-policy.mjs exports",
    "policy:imports": "node tooling/standalone-policy.mjs imports",
    "policy:deps": "node tooling/standalone-policy.mjs deps",
    "policy:packaging": "node tooling/standalone-policy.mjs packaging",
    "policy:audit-path": "node tooling/standalone-policy.mjs audit",
    "policy:privacy": "node tooling/standalone-policy.mjs privacy",
    "policy:static-export-hooks": "node tooling/standalone-policy.mjs static-export",
    "policy:standalone": "node tooling/standalone-policy.mjs all",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck:package": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:preview": "vue-tsc --noEmit -p preview-app/tsconfig.json",
    "check:fast": "npm run validate && npm run policy:standalone && npm run typecheck",
    "check:standalone": "npm run generate:check && npm run validate && npm run prove:definition-loader && npm run policy:standalone && npm run audit:prod && npm run typecheck && npm run test:components && npm run build && npm run preview:build && npm run pack:dry-run && npm run smoke:packed-consumer && npm run smoke:git-ref-consumer",
    "check:release": "npm run check:standalone",
    "test:components": "vitest run --config vitest.config.js src/groups/content/button src/groups/content/text src/sdk/__tests__/helper-exports.test.ts src/sdk/__tests__/browser-helpers.test.ts src/sdk/__tests__/validate-component.test.ts --maxWorkers=4",
    "test:sdk": "vitest run --config vitest.config.js src/sdk/__tests__/helper-exports.test.ts src/sdk/__tests__/browser-helpers.test.ts src/sdk/__tests__/validate-component.test.ts --maxWorkers=4",
    "test:sdk:fast": "npm run test:sdk",
    "test:groups": "vitest run --config vitest.config.js src/groups/content/button src/groups/content/text --maxWorkers=4",
    "test:groups:content": "npm run test:groups",
    "test:preview-app": "vitest run --config vitest.config.js preview-app/src --maxWorkers=1",
    "test:preview-app:fast": "vitest run --config vitest.config.js preview-app/src --maxWorkers=4",
    "test:components:sdk": "npm run test:sdk",
    "test:components:sdk:fast": "npm run test:sdk:fast",
    "test:components:groups": "npm run test:groups",
    "test:components:groups:content": "npm run test:groups:content",
    "test:components:preview-app": "npm run test:preview-app",
    "test:components:preview-app:fast": "npm run test:preview-app:fast",
    "test:components:pilot:fast": "npm run test:sdk:fast && npm run test:preview-app:fast",
    "test:components:lanes:audit": "node tooling/audit-package-component-lanes.mjs",
    "test:components:release": "npm run test:components && npm run test:preview-app:fast",
    "test:app-integration:host": "npm --prefix ../.. run test -- tests/unit/packages tests/unit/registry/static-component-source-files.spec.ts tests/unit/registry/static-package-catalog.spec.ts --maxWorkers=1",
    "test:app-integration:host:fast": "npm --prefix ../.. run test -- tests/unit/packages tests/unit/registry/static-component-source-files.spec.ts tests/unit/registry/static-package-catalog.spec.ts --maxWorkers=4",
    "check": "npm run check:release",
    "typecheck": "npm run typecheck:package && npm run typecheck:preview",
    "build:validate": "npm run validate && npm run typecheck:package",
    "build:library": "node scripts/build-package.mjs",
    "build:verify": "node scripts/verify-built-exports.mjs",
    "build": "npm run build:validate && npm run build:library && npm run build:verify",
    "pack:dry-run": "node scripts/verify-pack-contents.mjs --dry-run",
    "smoke:packed-consumer": "node scripts/smoke-packed-consumer.mjs",
    "smoke:git-ref-consumer": "node scripts/smoke-git-ref-consumer.mjs",
    "preview:dev": "vp dev ./preview-app --config ./preview-app/vite.config.js",
    "preview:build": "vp build ./preview-app --config ./preview-app/vite.config.js",
    "test:visual-state": "npm run preview:build && playwright test --config ./preview-app/playwright.config.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^16.4.0",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.1",
    "shadcn-vue": "^2.6.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.16",
    "vitest": "^4.1.5",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.1.1"
  },
  "peerDependencies": {
    "vue": "^3.5.32"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.4"
}
